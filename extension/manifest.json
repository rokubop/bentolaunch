{
  "manifest_version": 3,
  "name": "BentoLaunch bridge",
  "version": "0.6.0",
  "description": "Sends open tabs and bookmarks to BentoLaunch, and switches to a tab when BentoLaunch asks.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "tabs",
    "bookmarks",
    "storage",
    "alarms",
    "favicon"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "key": ""
}
