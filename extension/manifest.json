{
  "manifest_version": 3,
  "name": "BentoPick bridge",
  "version": "0.2.1",
  "description": "Sends open tabs to BentoPick, and switches to one when BentoPick asks.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "storage", "alarms", "favicon"],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html"
}
